#!/usr/bin/env bash
# Author: Muhammad Usman (MuhammadUsmanGM) | Sig: MUGM-b2e4-7f1a
# code-stick launcher — Linux (x64 + arm64). Generated at install time.
set -e

USB_ROOT="$(cd "$(dirname "$0")" && pwd)"

ARCH="$(uname -m)"
case "$ARCH" in
  aarch64|arm64) TARGET="linux-arm64" ;;
  x86_64|amd64)  TARGET="linux-x64" ;;
  *)
    echo "[code-stick] Unsupported Linux architecture: $ARCH"
    exit 1
    ;;
esac

OLLAMA_BIN="$USB_ROOT/engine/$TARGET/bin/ollama"
OPENCODE_BIN="$USB_ROOT/opencode/$TARGET/opencode"

# FAT32/exFAT can't store the +x bit, so binaries lose executability when the
# stick is mounted on Linux. Best-effort chmod (no-op on FAT — we'll fall back
# to invoking via the dynamic linker if needed).
chmod +x "$OLLAMA_BIN" "$OPENCODE_BIN" 2>/dev/null || true

if [ ! -f "$OLLAMA_BIN" ]; then
  echo "[code-stick] Missing: $OLLAMA_BIN"
  echo "[code-stick] Re-run: npx code-stick install --target \"$USB_ROOT\""
  exit 1
fi
if [ ! -f "$OPENCODE_BIN" ]; then
  echo "[code-stick] Missing: $OPENCODE_BIN"
  echo "[code-stick] Re-run: npx code-stick install --target \"$USB_ROOT\""
  exit 1
fi
if [ ! -x "$OLLAMA_BIN" ] || [ ! -x "$OPENCODE_BIN" ]; then
  echo "[code-stick] Binaries are not executable (exec bit lost — typical for FAT32/exFAT USBs)."
  # `bash "$0"` does NOT fix this — the script still tries to execve the
  # binary and hits ENOEXEC. The two real fixes:
  MOUNT_DEV="$(findmnt -no SOURCE --target "$USB_ROOT" 2>/dev/null || true)"
  MOUNT_POINT="$(findmnt -no TARGET --target "$USB_ROOT" 2>/dev/null || true)"
  echo
  echo "  Option 1 (recommended): remount the USB with exec perms."
  if [ -n "$MOUNT_DEV" ] && [ -n "$MOUNT_POINT" ]; then
    echo "    sudo mount -o remount,exec,uid=$(id -u),gid=$(id -g) \"$MOUNT_DEV\" \"$MOUNT_POINT\""
  else
    echo "    sudo mount -o remount,exec <device> <mountpoint>"
  fi
  echo
  echo "  Option 2: copy the binaries to a real filesystem (~/.local/bin) and run from there."
  echo "    cp \"$OLLAMA_BIN\" \"$OPENCODE_BIN\" ~/.local/bin/ && chmod +x ~/.local/bin/{ollama,opencode}"
  echo
  echo "  For long-term use, format the stick as NTFS or ext4 instead of FAT/exFAT."
  exit 1
fi

export OLLAMA_MODELS="$USB_ROOT/data"
export OLLAMA_HOST="127.0.0.1:11434"
# Pin opencode's config + caches onto the USB so nothing leaks to the host.
export XDG_CONFIG_HOME="$USB_ROOT/config"
export XDG_CACHE_HOME="$USB_ROOT/cache"
export XDG_DATA_HOME="$USB_ROOT/data/xdg"
export XDG_STATE_HOME="$USB_ROOT/state"
export OPENCODE_DISABLE_AUTOUPDATE=1
export OPENCODE_DISABLE_WATCHER=1
export OPENCODE_CONFIG="$USB_ROOT/config/opencode/opencode.json"
# Make bundled libs (if any) discoverable for the Ollama Linux build.
export LD_LIBRARY_PATH="$USB_ROOT/engine/$TARGET/lib:${LD_LIBRARY_PATH:-}"

cleanup() {
  if [ -n "${OLLAMA_PID:-}" ]; then
    echo
    echo "[code-stick] Stopping Ollama (PID $OLLAMA_PID)..."
    kill "$OLLAMA_PID" 2>/dev/null || true
    wait "$OLLAMA_PID" 2>/dev/null || true
  fi
}
trap cleanup EXIT INT TERM

# Refuse to start if 11434 is already bound — we won't fight another Ollama.
if command -v ss >/dev/null 2>&1; then
  if ss -lnt 2>/dev/null | awk '{print $4}' | grep -qE '(:|\.)11434$'; then
    echo "[code-stick] Port 11434 is already in use. Stop the other Ollama/process and retry."
    exit 1
  fi
elif command -v lsof >/dev/null 2>&1; then
  if lsof -nP -iTCP:11434 -sTCP:LISTEN >/dev/null 2>&1; then
    echo "[code-stick] Port 11434 is already in use. Stop the other Ollama/process and retry."
    exit 1
  fi
elif (echo > /dev/tcp/127.0.0.1/11434) >/dev/null 2>&1; then
  echo "[code-stick] Port 11434 is already in use. Stop the other Ollama/process and retry."
  exit 1
fi

echo "[code-stick] Starting Ollama from USB ($TARGET)..."
"$OLLAMA_BIN" serve > "/tmp/code-stick-ollama.log" 2>&1 &
OLLAMA_PID=$!

# Wait for Ollama port (up to ~30s).
READY=
for i in $(seq 1 60); do
  if command -v curl >/dev/null 2>&1; then
    if curl -fsS --max-time 1 http://127.0.0.1:11434/api/version >/dev/null 2>&1; then
      READY=1; break
    fi
  else
    if (echo > /dev/tcp/127.0.0.1/11434) >/dev/null 2>&1; then
      READY=1; break
    fi
  fi
  sleep 0.5
done

if [ -z "$READY" ]; then
  echo "[code-stick] Ollama did not start in time. Check /tmp/code-stick-ollama.log"
  exit 1
fi

echo "[code-stick] Launching opencode (model: <%= modelTag %>)..."
echo
"$OPENCODE_BIN"
