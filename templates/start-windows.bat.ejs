@echo off
REM Author: Muhammad Usman (MuhammadUsmanGM) | Sig: MUGM-b2e4-7f1a
REM code-stick launcher Ã¢â‚¬â€ Windows x64. Generated at install time; do not edit.
REM Fix: OLLAMA_MODELS passed via -EnvironmentVariables hashtable (space-safe).
setlocal ENABLEDELAYEDEXPANSION

REM Resolve USB root (this script lives at <USB>\start-windows.bat).
set "USB_ROOT=%~dp0"
if "%USB_ROOT:~-1%"=="\" set "USB_ROOT=%USB_ROOT:~0,-1%"

set "OLLAMA_BIN=%USB_ROOT%\engine\windows-x64\ollama.exe"
set "OPENCODE_BIN=%USB_ROOT%\opencode\windows-x64\opencode.exe"
set "OLLAMA_MODELS=%USB_ROOT%\data"
set "OLLAMA_HOST=127.0.0.1:11434"
REM Pin opencode's config + caches onto the USB so nothing leaks to the host.
REM xdg-basedir (the Node module opencode uses) honors these on Windows too,
REM and APPDATA/LOCALAPPDATA are the Windows-native fallbacks for the same dirs.
set "APPDATA=%USB_ROOT%\config"
set "LOCALAPPDATA=%USB_ROOT%\cache"
set "XDG_CONFIG_HOME=%USB_ROOT%\config"
set "XDG_CACHE_HOME=%USB_ROOT%\cache"
set "XDG_DATA_HOME=%USB_ROOT%\data\xdg"
set "XDG_STATE_HOME=%USB_ROOT%\state"
REM Skip opencode's autoupdate check + filesystem watcher (USB I/O is slow).
set "OPENCODE_DISABLE_AUTOUPDATE=1"
set "OPENCODE_DISABLE_WATCHER=1"
REM Pin the config file path explicitly Ã¢â‚¬â€ opencode honors $OPENCODE_CONFIG.
set "OPENCODE_CONFIG=%USB_ROOT%\config\opencode\opencode.json"

if not exist "%OLLAMA_BIN%" (
  echo [code-stick] Missing engine binary: %OLLAMA_BIN%
  echo [code-stick] Re-run: npx code-stick install --target "%USB_ROOT%"
  pause
  exit /b 1
)
if not exist "%OPENCODE_BIN%" (
  echo [code-stick] Missing opencode binary: %OPENCODE_BIN%
  echo [code-stick] Re-run: npx code-stick install --target "%USB_ROOT%"
  pause
  exit /b 1
)

REM Refuse to start if 11434 is already bound Ã¢â‚¬â€ we won't fight another Ollama
REM and we don't want to silently fail the wait loop 30s later.
powershell -NoProfile -Command "try { (New-Object Net.Sockets.TcpClient).Connect('127.0.0.1',11434); exit 0 } catch { exit 1 }" >nul 2>&1
if %ERRORLEVEL%==0 (
  echo [code-stick] Port 11434 is already in use. Stop the other Ollama/process and retry.
  pause
  exit /b 1
)

echo [code-stick] Starting Ollama from USB...
REM Capture the PID of the ollama process we spawn so we kill only ours on
REM exit Ã¢â‚¬â€ never touch a pre-existing ollama.exe the user might be running.
REM
REM We spawn via PowerShell -PassThru and write $p.Id to a temp file. Parsing
REM stdout via `for /f` is fragile: any banner / profile output / AV injection
REM corrupts the captured PID. Writing to a file and reading with `set /p`
REM survives that.
set "OLLAMA_PID="
set "OLLAMA_PID_FILE=%TEMP%\code-stick-ollama.pid"
del /q "%OLLAMA_PID_FILE%" >nul 2>&1
REM Set env vars at the process level ($env:X = Y modifies the process env
REM block; Start-Process inherits it). CRITICAL: cast $p.Id to [string] --
REM WriteAllText throws on PS 5.1 when given an int, leaving the PID file
REM empty and triggering the "not defined OLLAMA_PID" guard (kills launcher).
powershell -NoProfile -Command "$env:OLLAMA_MODELS = '%USB_ROOT%\data'; $env:OLLAMA_HOST = '127.0.0.1:11434'; $p = Start-Process -FilePath '%OLLAMA_BIN%' -ArgumentList 'serve' -WindowStyle Hidden -PassThru -RedirectStandardOutput '%TEMP%\code-stick-ollama.log' -RedirectStandardError '%TEMP%\code-stick-ollama.err'; [IO.File]::WriteAllText('%OLLAMA_PID_FILE%', [string]$p.Id)" >nul 2>&1
if exist "%OLLAMA_PID_FILE%" set /p OLLAMA_PID=<"%OLLAMA_PID_FILE%"
del /q "%OLLAMA_PID_FILE%" >nul 2>&1
if not defined OLLAMA_PID (
  echo [code-stick] Failed to spawn Ollama. See %TEMP%\code-stick-ollama.err
  pause
  exit /b 1
)

REM Wait for Ollama HTTP readiness (up to ~30s). Probe `/api/version` rather
REM than a raw TCP connect Ã¢â‚¬â€ Ollama opens the listening socket *before* the
REM HTTP handler is wired up, so a TCP-only probe returns ready prematurely
REM and opencode hits a 503 on its first request, surfacing as a confusing
REM "model not found". Match start-mac.command and start-linux.sh.
set /a TRIES=0
:waitloop
set /a TRIES+=1
powershell -NoProfile -Command "try { $r = Invoke-WebRequest -Uri 'http://127.0.0.1:11434/api/version' -UseBasicParsing -TimeoutSec 1; if ($r.StatusCode -eq 200) { exit 0 } else { exit 1 } } catch { exit 1 }" >nul 2>&1
if %ERRORLEVEL%==0 goto ready
if %TRIES% GEQ 60 goto timeout
timeout /t 1 /nobreak >nul
goto waitloop

:timeout
echo [code-stick] Ollama did not start in time. Check %TEMP%\code-stick-ollama.log
goto cleanup

:ready
echo [code-stick] Launching opencode (model: <%= modelTag %>)...
echo.
"%OPENCODE_BIN%"

:cleanup
echo.
if defined OLLAMA_PID (
  echo [code-stick] Stopping Ollama PID %OLLAMA_PID% and child workers...
  REM `taskkill /T` follows the Job-object / parent-PID chain, but Ollama spawns
  REM `ollama_llama_server.exe` workers that aren't always re-parented under
  REM the launcher PID. Walk Win32_Process via PowerShell to enumerate the
  REM full descendant tree (any depth) before falling back to taskkill.
  powershell -NoProfile -Command "$root=[int]'%OLLAMA_PID%'; $all=Get-CimInstance Win32_Process; $kill=New-Object System.Collections.Generic.List[int]; $kill.Add($root); $stack=New-Object System.Collections.Generic.Stack[int]; $stack.Push($root); while($stack.Count -gt 0){$p=$stack.Pop(); foreach($c in $all|Where-Object{$_.ParentProcessId -eq $p}){if(-not $kill.Contains([int]$c.ProcessId)){$kill.Add([int]$c.ProcessId); $stack.Push([int]$c.ProcessId)}}}; foreach($pid in $kill){try{Stop-Process -Id $pid -Force -ErrorAction Stop}catch{}}" >nul 2>&1
  REM Belt-and-braces: taskkill the original PID tree in case anything slipped.
  taskkill /PID %OLLAMA_PID% /T /F >nul 2>&1
)
endlocal
exit /b 0
