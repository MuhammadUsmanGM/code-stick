@echo off
REM Author: Muhammad Usman (MuhammadUsmanGM) | Sig: MUGM-b2e4-7f1a
REM code-stick launcher — Windows x64. Generated at install time; do not edit.
setlocal

REM Resolve USB root (this script lives at <USB>\start-windows.bat).
set "USB_ROOT=%~dp0"
if "%USB_ROOT:~-1%"=="\" set "USB_ROOT=%USB_ROOT:~0,-1%"

set "OLLAMA_BIN=%USB_ROOT%\engine\windows-x64\ollama.exe"
set "OPENCODE_BIN=%USB_ROOT%\opencode\windows-x64\opencode.exe"

if not exist "%OLLAMA_BIN%" (
  echo [code-stick] Missing engine binary: %OLLAMA_BIN%
  echo [code-stick] Re-run: npx code-stick install --target "%USB_ROOT%"
  pause
  exit /b 1
)
if not exist "%OPENCODE_BIN%" (
  echo [code-stick] Missing opencode binary: %OPENCODE_BIN%
  echo [code-stick] Re-run: npx code-stick install --target "%USB_ROOT%"
  pause
  exit /b 1
)

REM Delegate the entire spawn/wait/cleanup cycle to PowerShell so a
REM try/finally guarantees the Ollama child is killed even when the user
REM presses Ctrl+C (which would otherwise short-circuit a plain BAT cleanup).
REM ModelTag is passed via env so opencode can echo it before launch.
set "CODE_STICK_USB_ROOT=%USB_ROOT%"
set "CODE_STICK_MODEL_TAG=<%= modelTag %>"

powershell -NoProfile -ExecutionPolicy Bypass -Command ^
  "$ErrorActionPreference='Stop';" ^
  "$root=$env:CODE_STICK_USB_ROOT;" ^
  "$ollamaBin=Join-Path $root 'engine\windows-x64\ollama.exe';" ^
  "$opencodeBin=Join-Path $root 'opencode\windows-x64\opencode.exe';" ^
  "$env:OLLAMA_MODELS=Join-Path $root 'data';" ^
  "$env:OLLAMA_HOST='127.0.0.1:11434';" ^
  "$env:APPDATA=Join-Path $root 'config';" ^
  "$env:XDG_CONFIG_HOME=Join-Path $root 'config';" ^
  "$logOut=Join-Path $env:TEMP 'code-stick-ollama.log';" ^
  "$logErr=Join-Path $env:TEMP 'code-stick-ollama.err';" ^
  "Write-Host '[code-stick] Starting Ollama from USB...';" ^
  "$ollama=Start-Process -FilePath $ollamaBin -ArgumentList 'serve' -WindowStyle Hidden -PassThru -RedirectStandardOutput $logOut -RedirectStandardError $logErr;" ^
  "try {" ^
  "  $tries=0;" ^
  "  while ($tries -lt 60) {" ^
  "    try { (New-Object Net.Sockets.TcpClient).Connect('127.0.0.1',11434); break } catch { Start-Sleep -Seconds 1; $tries++ }" ^
  "  }" ^
  "  if ($tries -ge 60) { Write-Host \"[code-stick] Ollama did not start in time. Check $logOut\"; exit 1 }" ^
  "  Write-Host \"[code-stick] Launching opencode (model: $env:CODE_STICK_MODEL_TAG)...\"; Write-Host '';" ^
  "  $opencode=Start-Process -FilePath $opencodeBin -NoNewWindow -PassThru -Wait;" ^
  "  exit $opencode.ExitCode" ^
  "} finally {" ^
  "  if ($ollama -and -not $ollama.HasExited) {" ^
  "    Write-Host \"\"; Write-Host \"[code-stick] Stopping Ollama PID $($ollama.Id)...\";" ^
  "    try { Stop-Process -Id $ollama.Id -Force -ErrorAction SilentlyContinue } catch {}" ^
  "  }" ^
  "}"

set "EXITCODE=%ERRORLEVEL%"
endlocal & exit /b %EXITCODE%
